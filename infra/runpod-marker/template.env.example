# This image accepts only RunPod Serverless jobs. It uses short-lived signed
# input/output URLs and must only be allowed to follow Oghma object-storage
# hosts. This example deliberately contains no credentials.
MARKER_HANDLER_CONCURRENCY=3
MARKER_RUNTIME=serverless
MARKER_CONVERT_CONCURRENCY=1
MARKER_PDFTEXT_WORKERS=1
MARKER_ALLOWED_OBJECT_HOSTS=<account-id>.r2.cloudflarestorage.com
MARKER_MAX_SOURCE_BYTES=262144000
# Initial safety cap for compact Marker result objects; R2 handles the signed PUT.
MARKER_MAX_RESULT_BYTES=94371840
MARKER_TRANSFER_TIMEOUT_SECONDS=600
MARKER_PROCESS_WARM_TIMEOUT_SECONDS=180
MARKER_MAX_APP_SUBMIT_TO_HANDLER_MS=43200000
TORCH_DEVICE=cpu
HF_HOME=/opt/marker-cache/huggingface
TORCH_HOME=/opt/marker-cache/torch
XDG_CACHE_HOME=/opt/marker-cache
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
MARKER_PROFILE=1
MARKER_TELEMETRY_INTERVAL_SECONDS=1
# RunPod Serverless waits this long for the image entrypoint to start.
RUNPOD_INIT_TIMEOUT=800
