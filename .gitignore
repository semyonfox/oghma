# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

.idea
*.pem

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# local agent state
/.agent/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
tsconfig.tsbuildinfo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pnpm-lock.yaml

# env files: ignore all, only .env.example and *.template files committed
.env*
!.env.example
!.env.e2e.example
!.env.mock.example
!*.template

# local-specific envs
.env.local
.env.development.local
.env.test.local
.env.production.local

# explicit entries for envs we want ignored
.env.deploy
stack.env

# backups of old envs
env.old/
.env

# generated manifests that may contain secrets
STORAGE_FINDINGS_MANIFEST.txt

# logs and debug output
logs/
firebase-debug.log

# backup files
*.bak

# local agent tooling
.claude/
.hermes/
database/schema-current.json
.superpowers/

# worktrees
.worktrees/

# lambda build output
infra/chat-lambda/dist/

# aws migration export
aws-export/

# private business / internal docs — share via discord / private repo, never commit
docs/internal/

# local screenshot and diagram scratch, archived coursework copies live in docs/history/coursework
/diagrams/
/screenshots/

# RunPod Marker: keep only the reproducible, credential-free Serverless worker
# source. Local image archives, benchmark scratch, bootstrap scripts, and other
# experiments remain ignored.
infra/runpod-marker/*
!infra/runpod-marker/README.md
!infra/runpod-marker/handler.py
!infra/runpod-marker/requirements-test.txt
!infra/runpod-marker/requirements.txt
!infra/runpod-marker/run.sh
!infra/runpod-marker/serverless-plan.json
!infra/runpod-marker/template.env.example
!infra/runpod-marker/test_handler.py
scripts/runpod-marker-quick-deploy.sh
scripts/runpod-marker-tail.sh

# python (marker server + tests)
__pycache__/
*.pyc
.pytest_cache/

# Android alpha
apps/mobile/node_modules/
apps/mobile/.expo/
apps/mobile/dist/
apps/mobile/android/
apps/mobile/ios/
*.apk
*.aab
*.keystore
*.jks

# local exam archive and generated imports
/exam-library/

# local source-map upload credential
.env.sentry-build-plugin
