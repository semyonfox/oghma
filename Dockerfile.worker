FROM node:24-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d
WORKDIR /app
COPY package*.json ./
RUN npm pkg delete scripts.prepare && npm ci --legacy-peer-deps --omit=dev
COPY tsconfig.json ./
COPY scripts/ ./scripts/
COPY src/ ./src/
COPY infra/vast-marker/jvastai_root.cer /app/certs/vast-jvastai-root.cer
ENV NODE_ENV=production
ARG SENTRY_ENVIRONMENT=production
ARG SENTRY_RELEASE
ENV SENTRY_ENVIRONMENT=$SENTRY_ENVIRONMENT
ENV SENTRY_RELEASE=$SENTRY_RELEASE
ENV NODE_EXTRA_CA_CERTS=/app/certs/vast-jvastai-root.cer
CMD ["npm", "run", "worker"]
