{
  "name": "oghmanotes",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:mock": "node --experimental-strip-types scripts/dev/run-mock.ts next dev -p 3311",
    "mock:up": "docker compose -f docker-compose.e2e.yml up -d --wait",
    "mock:down": "docker compose -f docker-compose.e2e.yml down -v",
    "mock:seed": "node --experimental-strip-types scripts/dev/run-mock.ts node --experimental-strip-types scripts/e2e/reset-db.ts && node --experimental-strip-types scripts/dev/run-mock.ts node --experimental-strip-types scripts/e2e/create-storage-bucket.ts && node --experimental-strip-types scripts/dev/run-mock.ts tsx scripts/dev/seed-sample-paper.ts",
    "worker": "tsx src/lib/canvas/worker-entry.ts",
    "build": "next build",
    "migrate": "node --experimental-strip-types scripts/prebuild-migrate.ts",
    "cf:setup": "node --experimental-strip-types scripts/cloudflare/setup-r2-queues.ts",
    "cf:migrate-storage": "node --experimental-strip-types scripts/cloudflare/migrate-storage-to-r2.ts",
    "start": "next start",
    "start:next": "next start",
    "lint": "eslint",
    "lint:all": "eslint . && npm run i18n:audit && npm run typecheck && npm run test:ci",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit && npm run typecheck:canvas-mcp",
    "typecheck:canvas-mcp": "node node_modules/typescript-7/bin/tsc --noEmit -p src/lib/canvas-mcp/tsconfig.json",
    "test": "vitest",
    "test:canvas-mcp": "npm --prefix src/lib/canvas-mcp run test",
    "test:ci": "vitest run && npm run test:canvas-mcp",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node --experimental-strip-types scripts/e2e/run-with-env.ts vitest run -c vitest.integration.config.ts",
    "worker:healthcheck": "tsx scripts/worker-healthcheck.ts",
    "worker:retry-pending": "tsx scripts/process-pending-retry-local.ts",
    "e2e": "node --experimental-strip-types scripts/e2e/run-with-env.ts playwright test",
    "e2e:smoke": "node --experimental-strip-types scripts/e2e/run-with-env.ts playwright test tests/e2e/smoke",
    "e2e:smoke:public": "node --experimental-strip-types scripts/e2e/run-with-env.ts playwright test tests/e2e/smoke/public.spec.ts",
    "e2e:full": "node --experimental-strip-types scripts/e2e/run-with-env.ts playwright test tests/e2e/full",
    "e2e:worker": "node --experimental-strip-types scripts/e2e/run-with-env.ts npm run worker",
    "e2e:worker:healthcheck": "node --experimental-strip-types scripts/e2e/run-with-env.ts npm run worker:healthcheck",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:services:up": "docker compose -f docker-compose.e2e.yml up -d --wait",
    "e2e:services:down": "docker compose -f docker-compose.e2e.yml down -v",
    "e2e:reset": "node --experimental-strip-types scripts/e2e/run-with-env.ts node --experimental-strip-types scripts/e2e/reset-db.ts && node --experimental-strip-types scripts/e2e/run-with-env.ts node --experimental-strip-types scripts/e2e/create-storage-bucket.ts",
    "docker:marker:build": "docker build -f Dockerfile.marker -t marker-ocr:latest .",
    "docker:marker:validate": "docker buildx build -f Dockerfile.marker --check .",
    "benchmark:marker": "bash scripts/marker-bench-python.sh",
    "benchmark:marker:diagnostic": "bash scripts/marker-bench-python.sh diagnostic",
    "benchmark:marker:prepare": "bash scripts/marker-bench-prepare-instance.sh",
    "benchmark:marker:http:prototype": "node --experimental-strip-types scripts/benchmark-marker.ts",
    "benchmark:marker:urls": "node --experimental-strip-types scripts/generate-marker-bench-urls.ts",
    "benchmark:marker:download": "node --experimental-strip-types scripts/marker-bench-download.ts",
    "benchmark:marker:artifacts": "python3 scripts/marker-bench-artifacts.py",
    "benchmark:marker:aws": "python3 scripts/marker-aws-session.py",
    "benchmark:marker:test": "python3 -m unittest discover -s scripts/tests -p 'test_marker_bench*.py'",
    "marker:vast:plan": "node --experimental-strip-types scripts/vast-marker-plan.ts",
    "marker:runpod:build": "bash scripts/build-runpod-marker-image.sh",
    "marker:runpod:validate": "RUNPOD_MARKER_VALIDATE_ONLY=1 bash scripts/build-runpod-marker-image.sh",
    "marker:serverless:status": "node --experimental-strip-types scripts/marker-serverless-status.ts",
    "cache:reprocess": "node --import=tsx scripts/reprocess-import-cache-revisions.mjs",
    "cache:apply-revisions": "node --import=tsx scripts/apply-import-cache-revisions.mjs",
    "prepare": "husky",
    "i18n:audit": "node --experimental-strip-types scripts/i18n-audit.ts"
  },
  "dependencies": {
    "@ai-sdk/mcp": "2.0.35",
    "@aws-sdk/client-s3": "3.1116.0",
    "@aws-sdk/s3-request-presigner": "3.1116.0",
    "@fontsource-variable/strichpunkt-sans": "^5.3.0",
    "@headlessui/react": "2.2.10",
    "@heroicons/react": "^2.2.0",
    "@milkdown/crepe": "^7.22.1",
    "@milkdown/kit": "^7.22.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@testing-library/dom": "10.4.1",
    "ai": "7.0.76",
    "bcryptjs": "^3.0.3",
    "bullmq": "6.2.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dompurify": "3.4.14",
    "fflate": "0.8.3",
    "idb": "^8.0.3",
    "ioredis": "6.0.0",
    "jsonwebtoken": "^9.0.3",
    "katex": "0.18.4",
    "markdown-link-extractor": "^4.0.4",
    "mermaid": "^11.17.0",
    "motion": "13.1.1",
    "nanoid": "6.0.1",
    "next": "16.3.2",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "postgres": "3.4.9",
    "pupa": "^3.3.0",
    "qss": "^3.0.0",
    "react": "19.2.8",
    "react-complex-tree": "^2.6.3",
    "react-dom": "19.2.8",
    "react-hotkeys-hook": "5.3.3",
    "react-markdown": "^10.1.0",
    "react-pdf": "10.5.0",
    "react-resizable-panels": "4.12.3",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remove-markdown": "0.6.4",
    "rosetta": "^1.1.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "ts-fsrs": "5.4.1",
    "tsx": "4.23.12",
    "use-debounce": "^10.1.1",
    "uuid": "14.0.2",
    "validator": "13.15.35",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/canvas-confetti": "1.9.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/lodash": "4.17.25",
    "@types/node": "22.20.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/validator": "13.15.10",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "autoprefixer": "10.5.4",
    "eslint": "10.9.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "ioredis": "$ioredis",
    "postcss": "$postcss"
  }
}
