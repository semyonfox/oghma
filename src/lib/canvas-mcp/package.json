{
  "name": "canvas-mcp",
  "version": "0.2.0",
  "description": "Unified MCP server for Canvas LMS",
  "type": "module",
  "bin": {
    "canvas-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "node ../../../node_modules/typescript-7/bin/tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node ../../../node_modules/typescript-7/bin/tsc --noEmit && node ../../../node_modules/typescript-7/bin/tsc --noEmit -p tsconfig.scripts.json",
    "verify-tools": "node --experimental-strip-types scripts/verify-tools.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "tsx": "4.22.4",
    "typescript": "^7.0.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  }
}
